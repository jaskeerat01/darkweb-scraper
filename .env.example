# ============================================================================
# Dark Web Threat Intelligence Engine — example configuration
# Copy to .env and edit. Never commit .env.
# ============================================================================

# Tor Networking
TOR_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=change-me
TOR_NEWNYM_MIN_INTERVAL=10
TOR_RENEW_INTERVAL_MINUTES=30

# Job Intervals (minutes)
SCRAPE_INTERVAL_MINUTES=120
HEALTH_INTERVAL_MINUTES=30

# Telegram Alerting (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY=
TELEGRAM_QUEUE_SIZE=500

# Threat Intelligence Keywords (comma-separated)
KEYWORDS=data breach,exploit,crypto,leak,0day,ransomware,victim
LLM_PREFILTER_KEYWORDS=true

# Local LLM
GGUF_MODEL_PATH=models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_CONTEXT=4096
LLM_THREADS=4
LLM_GPU_LAYERS=0
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_FAIL_OPEN=true
LLM_CACHE_ENABLED=true
LLM_CACHE_DAYS=30

# Concurrency & Pacing
MAX_PARALLEL_SITES=3
MAX_PARALLEL_FETCHES=3
MAX_PARALLEL_HEALTH=6
MAX_LLM_WORKERS=1
MAX_FETCHES_PER_DOMAIN=1
DOMAIN_MIN_INTERVAL=2.0
FETCH_RETRIES=2
FETCH_BACKOFF_BASE=2.0

# Crawl Depth & Page Limits
PAGE_DISCOVERY_ENABLED=true
MAX_PAGES_PER_SITE=50
PAGE_DISCOVERY_DEPTH=2
MAX_LINKS_PER_PAGE=25
MIN_LINK_SCORE=-10
FOLLOW_EXTERNAL_LINKS=false
MAX_EXTERNAL_LINKS_PER_SITE=2
REQUIRE_RELEVANCE=true
THREAD_FIRST_PAGE_ONLY=true
FIRST_POST_ONLY=true
SUMMARIZE_ALERTS=true

# Cycle budgets (seconds)
SCRAPE_CYCLE_BUDGET_SECONDS=3600
SITE_BUDGET_SECONDS=600

# Clearnet targets.
# All target traffic still goes through Tor; never direct.
# Clearnet is disabled by default. When enabled, use an allowlist for routine
# use. CLEARNET_ALLOW_ANY=true is an explicit escape hatch for any public host.
ALLOW_CLEARNET_TARGETS=false
CLEARNET_ALLOWED_DOMAINS=
CLEARNET_ALLOW_ANY=false
CLEARNET_ALLOWED_PORTS=80,443
CLEARNET_REQUIRE_HTTPS=false
CLEARNET_MAX_REDIRECTS=3

# Storage and target inputs
DB_PATH=data/alerts.db
CSV_PATH=data/forum_sites.csv
DATA_RETENTION_DAYS=500
SEED_REMOVE_MISSING=false

# Timeouts and safeguards
HEALTH_TIMEOUT=15
REQUEST_TIMEOUT=60
MAX_FAILURES=2
MAX_RESPONSE_BYTES=5242880

# OPSEC
REDACT_URLS_IN_LOGS=false
INCLUDE_SOURCE_URL_IN_ALERTS=true

# ============================================================================
# Dashboard (read-only; separate process)
# The dashboard only reads DASHBOARD_* and DB_PATH. It never needs Tor or
# Telegram credentials. Prefer a dedicated /etc/darkweb-dashboard.env for the
# systemd unit so the dashboard process does not inherit scraper secrets.
# ============================================================================
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_DB_PATH=
# Set to require a login token. If bound to a non-loopback address, a token is
# mandatory and the dashboard refuses to start without one.
DASHBOARD_AUTH_TOKEN=
# Optional: load dashboard settings from a dedicated env file (manual runs).
# DASHBOARD_ENV_FILE=/etc/darkweb-dashboard.env
DASHBOARD_SECURE_COOKIE=false
DASHBOARD_ALLOWED_HOSTS=127.0.0.1,localhost,::1
DASHBOARD_PAGE_SIZE=25
DASHBOARD_POLL_SECONDS=15
DASHBOARD_ACCESS_LOG=false
DASHBOARD_ENABLE_DOCS=false
